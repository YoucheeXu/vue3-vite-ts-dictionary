{
  "compilerOptions": {
    "target": "ESNext", // 目标 ECMAScript 版本
    // "module": "NodeNext", // 使用 ESNext 模块系统
    "module": "ESNext", // 使用 ESNext 模块系统
    // "module": "ESNext", // 使用 ESNext 模块系统
    // "moduleResolution": "NodeNext", // 使用 Node.js 模块解析策略
    "moduleResolution": "Node", // 使用 Node.js 模块解析策略
    "declaration": false, // 生成对应的 `.d.ts` 声明文件
    "strict": true,
    "outDir": "../build", // 输出目录
    "skipLibCheck": true, // 跳过库文件的类型检查，提升编译速度
    "esModuleInterop": true, // 允许以更轻松的方式导入 CommonJS 模块
    // 🔥 1. 配置 baseUrl（必须）
    "baseUrl": ".",
    // 🔥 2. 同步 Vite 别名的路径映射
    "paths": {
      "@/*": [
        "./src/*"
      ], // 匹配 src 下的所有文件/目录
      "~s/*": [
        "./src/store/*"
      ],
      "~h/*": [
        "./src/hooks/*"
      ],
      "~/*": [
        "./types/*"
      ]
    }
  },
    "include": [
      "src/**/*.ts",
      "src/**/*.d.ts",
      "src/**/*.tsx",
      "src/**/*.vue",
      "types/**/*.d.ts"
    ],
  "exclude": [
    "src/**/__tests__/*",
    "node_modules", // 排除 Node.js 模块
    "public",
    "**/*.spec.ts" // 排除测试文件
  ]
  // "files": [],
  // "references": [
  //   {
  //     "path": "./tsconfig.app.json"
  //   },
  //   {
  //     "path": "./tsconfig.node.json"
  //   }
  // ]
}